# Local environment variables for the eval harness
# Copy this file to .env and fill in your values.
# .env is in .gitignore — NEVER commit it to git.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Pick ONE provider and uncomment its EVAL_MODEL line.

# Option A: Google Gemini (get key at https://aistudio.google.com)
GEMINI_API_KEY=
# EVAL_MODEL=gemini/gemini-3.6-flash

# Option B: Groq (free tier — https://console.groq.com)
GROQ_API_KEY=
EVAL_MODEL=groq/llama-3.3-70b-versatile

# Option C: Local Ollama (no API key needed — run: ollama pull llama3.2)
# EVAL_MODEL=ollama/llama3.2

# ── MCP Server ────────────────────────────────────────────────────────────────
SERVER_BIN=./schema-mcp
DSN=user:password@tcp(host:port)/dbname?tls=skip-verify
CONTEXT_FILE=./examples/synthea/context.yaml

# ── DeepEval ──────────────────────────────────────────────────────────────────
DEEPEVAL_TELEMETRY_OPT_OUT=YES
